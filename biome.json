{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "error",
				"useImportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"complexity": {
				"noBannedTypes": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"packages/*/src/**",
			"packages/*/app/**",
			"*.ts",
			"*.json",
			"!packages/api/src/api/db/migrations"
		]
	},
	"overrides": [
		{
			"includes": ["packages/web/app/*.css"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnknownProperty": "off",
						"noUnknownFunction": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/web/app/routes.ts"],
			"formatter": {
				"enabled": false
			},
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			}
		}
	]
}
