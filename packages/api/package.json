{
	"name": "@tomo/api",
	"type": "module",
	"exports": {
		".": "./src/exports.ts"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:better-sqlite3 --outfile=dist/index.mjs",
		"start": "node dist/index.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"test": "vitest run --passWithNoTests",
		"test:dev": "vitest --passWithNoTests"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.9",
		"nanoid": "^6.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.4",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}
