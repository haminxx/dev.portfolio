# Public hostname, no scheme. Caddy, the production auth base URL, and
# trusted origins use this. Defaults to tomo.computer when unset.
DOMAIN=tomo.computer

DATABASE_PATH=.tomo/tomo.db

# Required. Session signing secret. Generate one and keep it out of git:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Powers the Codex agent inside the workspace sandbox.
OPENAI_API_KEY=

# Google sign-in. Only the owner needs it: signing in is how the visitor
# dashboard unlocks. Authorized redirect URI is https://$DOMAIN/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Visitor analytics, written to the Supabase project with the secret (service-role)
# key. Server only — it is never sent to the browser. Leave both blank to turn
# analytics off entirely; the site and the consent banner still work.
# SUPABASE_SECRET_KEY is the sb_secret_... key from Project settings → API keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Comma-separated emails allowed to open /dashboard. Defaults to
# christianjameslee1@gmail.com and wildkid123456@gmail.com when unset.
# OWNER_EMAILS=

# SSH target for pnpm ssh, pnpm ship, and pnpm vm:status.
# VM_HOST is the public IPv4 from `tofu -chdir=infra output -raw ip`.
# VM_HOST=
# SSH_USER=ubuntu
# SSH_KEY=

# Oracle deploy settings live in infra/terraform.tfvars (see terraform.tfvars.example).
# Do not put tenancy OCIDs, the API fingerprint, or a private key in this file.
