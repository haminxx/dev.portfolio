# Public hostname, no scheme. Caddy, the production auth base URL, and
# trusted origins use this. Defaults to tomo.computer when unset.
DOMAIN=tomo.computer

DATABASE_PATH=.tomo/tomo.db

# Required. Session signing secret. Generate one and keep it out of git:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Powers the Codex agent inside the workspace sandbox.
OPENAI_API_KEY=

# Optional and unused in portfolio mode. The login screen is not public.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional shell overrides for gcloud and the live URL. Defaults match the
# original project. OpenTofu equivalents live in infra/terraform.tfvars.example.
# Do not apply until these accounts are yours.
# GCP_PROJECT=tomo-computer
# GCP_ZONE=us-west1-b
# VM_NAME=tomo
# TF_STATE_BUCKET=tomo-computer-tfstate
